{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slate.dev/schema/canvas-document.schema.json",
  "title": "Slate Canvas document",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "mode", "recordSources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "kind": { "$ref": "#/$defs/id" },
    "mode": { "type": "string", "const": "readonly" },
    "source": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "href": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observed": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "recordSources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "additionalProperties": false
      }
    },
    "defaultPerspectiveId": { "$ref": "#/$defs/id" },
    "perspectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/perspective" }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": { "$ref": "#/$defs/group" }
    },
    "placements": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/placement" }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "groupColumns": { "type": "integer", "minimum": 1, "maximum": 4 },
        "childGroupColumns": { "type": "integer", "minimum": 1, "maximum": 4 },
        "recordColumns": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "required": ["groups", "placements"] },
    { "required": ["defaultPerspectiveId", "perspectives"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "group": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "parentId": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "maxLength": 500 },
        "level": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3", "L4", "section"]
        },
        "route": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "maxLength": 160 },
        "sections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "purpose": { "type": "string", "maxLength": 500 }
            },
            "additionalProperties": false
          }
        },
        "tone": {
          "type": "string",
          "enum": ["aqua", "blue", "green", "gold", "coral", "rose", "lilac", "teal", "neutral"]
        },
        "order": { "type": "number" }
      },
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["id", "groupId", "recordRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "groupId": { "$ref": "#/$defs/id" },
        "recordRef": {
          "type": "object",
          "required": ["sourceId", "recordId"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/id" },
            "recordId": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        "variant": { "type": "string", "enum": ["compact", "standard"] },
        "order": { "type": "number" }
      },
      "additionalProperties": false
    },
    "perspective": {
      "type": "object",
      "required": ["id", "title", "groups", "placements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/group" }
        },
        "placements": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/placement" }
        },
        "presentation": {
          "type": "object",
          "properties": {
            "groupColumns": { "type": "integer", "minimum": 1, "maximum": 4 },
            "childGroupColumns": { "type": "integer", "minimum": 1, "maximum": 4 },
            "recordColumns": { "type": "integer", "minimum": 1, "maximum": 3 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}