{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slate.dev/schema/canvas-record-set.schema.json",
  "title": "Slate Canvas record set",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "record": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 320 },
        "summary": { "type": "string", "maxLength": 2000 },
        "eyebrow": { "type": "string", "maxLength": 160 },
        "source": {
          "type": "object",
          "required": ["label", "href"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 160 },
            "href": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "additionalProperties": false
        },
        "metadata": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "value": { "type": "string", "maxLength": 320 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}